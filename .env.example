# Set these in Vercel: Project > Settings > Environment Variables
ADMIN_PASSWORD=use-a-long-passphrase
# generate with: openssl rand -hex 32
SESSION_SECRET=use-a-random-64-char-secret
# KV_REST_API_URL and KV_REST_API_TOKEN are added automatically when you
# connect an Upstash Redis database to the project (Storage tab).
