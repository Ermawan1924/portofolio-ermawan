# copy to .env and fill in
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-random-secret
# set to true when served over HTTPS
COOKIE_SECURE=false
# set to true when behind Nginx/Caddy so rate limiting sees real client IPs
TRUST_PROXY=false
